# Google Books API key (optional -- works without one at lower rate)
GOOGLE_BOOKS_API_KEY=

# API base URL for frontend
API_BASE_URL=http://localhost:8000

# Ingestion settings
INGESTION_MAX_PAGES_PER_QUERY=5
INGESTION_RATE_LIMIT_SEC=0.2

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SEC=60
